<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DshSessionHud.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DshSessionHud"
    mc:Ignorable="d">

    <!--
        所有尺寸都绑定到 Metrics（见 HudMetrics.cs）：窗口一跨过分层边界，
        字号、留白、按键大小、列宽、显示哪些区块会一起变化。

        注意工具行那一块：列宽**不能**用 ColumnDefinition 绑定——ColumnDefinition
        不是 FrameworkElement，拿不到 DataContext。所以那里用固定宽度的 TextBlock
        放在 Auto 列里（Auto 列会量出 TextBlock 的显式宽度），加上 TextTrimming
        既保证跨行对齐，又保证长名字只会被截断、不会串到描述列上。
    -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <!-- 格子模式的磁贴：只留「谁在干什么」这个最核心的信息。
                 磁贴尺寸由 UniformGridLayout 决定（见 ApplyViewMode），
                 所以这里不设 Margin —— 间距交给布局的 MinRowSpacing/MinColumnSpacing，
                 否则会和布局间距叠加。 -->
            <DataTemplate x:Key="GridTileTemplate">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="{Binding Metrics.CardPadding}">
                    <StackPanel Spacing="{Binding Metrics.SectionSpacing}">

                        <!-- 状态点 + 标题 + 计时 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,7,0"
                                     VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       FontSize="{Binding Metrics.TitleFontSize}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{Binding Metrics.ElapsedFontSize}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>

                        <!-- 当前工作：磁贴的核心内容 -->
                        <StackPanel Spacing="2" Visibility="{Binding CurrentVisibility}">
                            <TextBlock Text="{Binding CurrentLabel}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{Binding Metrics.SmallFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding CurrentDetail}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxLines="{Binding TileDetailLines}"
                                       FontFamily="Cascadia Mono,Consolas,Courier New"
                                       FontSize="{Binding Metrics.MonoFontSize}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <!-- 空闲时用工作区 / 模型 / 批准策略补位 -->
                        <TextBlock Text="{Binding TileSubtitle}" TextTrimming="CharacterEllipsis"
                                   FontSize="{Binding Metrics.SmallFontSize}"
                                   Visibility="{Binding NoCurrentVisibility}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <!-- 上一条输出：这就是「精简」在格子模式下的可见效果（关掉才有）。
                             同样走 Markdown 渲染。 -->
                        <RichTextBlock TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                       FontSize="{Binding Metrics.SmallFontSize}"
                                       Visibility="{Binding TileLastTextVisibility}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       local:MarkdownText.Source="{Binding LastText}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <!-- ================= 自定义标题栏：整条都可以拖动窗口 ================= -->
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent"
              Height="{Binding Metrics.TitleBarHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE9D9;" Margin="12,0,8,0"
                      FontSize="{Binding Metrics.ButtonIconSize}"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

            <!-- 标题必须放在 Grid 的 * 列里并开 TextTrimming。
                 早先这里是「一个横向 StackPanel 装标题 + 连接状态」：
                 StackPanel 会给子元素**无限宽度**，TextTrimming 因此永远不触发，
                 文字直接溢出到右侧按键底下 —— 看起来就是标题与按键重叠。
                 只有 Grid 的列才是硬宽度约束，裁剪才会生效。 -->
            <TextBlock Grid.Column="1" Text="{Binding Metrics.TitleText}" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="{Binding Metrics.TitleFontSize}"
                       Visibility="{Binding Metrics.AppTitleVisibility}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <!-- 自定义按键 + 系统按钮保留区放在同一个右对齐组里。
                 保留区是**按键后面的兄弟元素**而不是独立列，这样按键一定紧贴
                 系统按钮左侧，不会随 Grid 列分配漂移。 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"
                            Spacing="{Binding Metrics.ButtonSpacing}">
                    <ToggleButton x:Name="TopmostToggle" Padding="0" MinWidth="0"
                                  Width="{Binding Metrics.ButtonWidth}" Height="{Binding Metrics.ButtonHeight}"
                                  AutomationProperties.Name="窗口置顶"
                                  ToolTipService.ToolTip="窗口置顶">
                        <FontIcon Glyph="&#xE718;" FontSize="{Binding Metrics.ButtonIconSize}" />
                    </ToggleButton>
                    <ToggleButton x:Name="CompactToggle" Padding="0" MinWidth="0"
                                  Width="{Binding Metrics.ButtonWidth}" Height="{Binding Metrics.ButtonHeight}"
                                  AutomationProperties.Name="精简模式"
                                  ToolTipService.ToolTip="精简模式（列表隐藏最近活动 / 磁贴隐藏上一条输出）">
                        <FontIcon Glyph="&#xE71D;" FontSize="{Binding Metrics.ButtonIconSize}" />
                    </ToggleButton>
                    <Button x:Name="ViewModeButton" Padding="0" MinWidth="0"
                            Width="{Binding Metrics.ButtonWidth}" Height="{Binding Metrics.ButtonHeight}"
                            AutomationProperties.Name="视图模式"
                            ToolTipService.ToolTip="视图模式（列表 / 格子）">
                        <FontIcon x:Name="ViewModeIcon" Glyph="&#xE8FD;"
                                  FontSize="{Binding Metrics.ButtonIconSize}" />
                    </Button>
                    <Button x:Name="SettingsButton" Padding="0" MinWidth="0"
                            Width="{Binding Metrics.ButtonWidth}" Height="{Binding Metrics.ButtonHeight}"
                            AutomationProperties.Name="设置"
                            ToolTipService.ToolTip="设置（显示上限 / 空闲隐藏 / 主题）">
                        <FontIcon Glyph="&#xE713;" FontSize="{Binding Metrics.ButtonIconSize}" />
                        <Button.Flyout>
                            <!-- 设置面板。主题也收进来了：标题栏再放第五个按键就挤不下标题了，
                                 而主题本来就是「偶尔改一次」的设置，不是需要随手点的开关。 -->
                            <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight">
                                <!-- 宽度 322：够放下拉与说明文字 -->
                                <StackPanel Width="322" Spacing="16">
                                    <TextBlock Text="设置" FontWeight="SemiBold"
                                               FontSize="{Binding Metrics.TitleFontSize}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="显示会话上限" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <NumberBox x:Name="MaxSessionsBox" Minimum="0" Maximum="50"
                                                   SmallChange="1" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="OnMaxSessionsChanged" />
                                        <TextBlock Text="0 = 不限制。按「待批准 → 运行中 → 最近活动」排序后取前几个。"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="空闲超过多少分钟就隐藏" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <NumberBox x:Name="HideIdleBox" Minimum="0" Maximum="1440"
                                                   SmallChange="5" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="OnHideIdleChanged" />
                                        <TextBlock Text="0 = 从不隐藏。等待批准和正在运行的会话永不隐藏。"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="明暗主题" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <!-- 用 ComboBox 而不是 RadioButtons：三个单选项在
                                             RadioButtons 里会按 ceil(sqrt(n)) 折成 2+1 两行，
                                             下拉一行就够，也更省纵向空间。 -->
                                        <ComboBox x:Name="ThemeSelector" HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnThemeSelectionChanged">
                                            <ComboBoxItem Content="跟随系统" />
                                            <ComboBoxItem Content="浅色" />
                                            <ComboBoxItem Content="深色" />
                                        </ComboBox>
                                    </StackPanel>

                                    <TextBlock Text="设置与窗口位置一起保存，下次打开保持不变。"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <!-- 系统的最小化/最大化/关闭就画在这块保留区里 -->
                <Border Width="{Binding Metrics.TitleBarReserve}" Height="1" />
            </StackPanel>
        </Grid>

        <!-- ================= 待批准提示 ================= -->
        <StackPanel x:Name="ApprovalSection" Grid.Row="1" Margin="10,0,10,8" Spacing="6"
                    Visibility="{Binding ApprovalsVisibility}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE7BA;" VerticalAlignment="Center"
                          FontSize="{Binding Metrics.ButtonIconSize}"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding ApprovalHeaderText}" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontSize="{Binding Metrics.TitleFontSize}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Approvals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                BorderThickness="1" CornerRadius="6" Margin="0,0,0,6"
                                Padding="{Binding Metrics.InnerPadding}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding ToolText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           FontSize="{Binding Metrics.TitleFontSize}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding ReasonText}" TextWrapping="Wrap"
                                           FontSize="{Binding Metrics.BodyFontSize}"
                                           Visibility="{Binding ReasonVisibility}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding MetaText}" TextWrapping="Wrap"
                                           FontSize="{Binding Metrics.SmallFontSize}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ================= 会话列表 ================= -->
        <Grid Grid.Row="2">
            <!-- 内边距放在 ItemsRepeater 的 Margin 上（而不是 ScrollViewer.Padding）：
                 两者效果等价，放在内容上让「列表留白」和卡片间距由同一套 Metrics 控制。
                 HorizontalScrollMode 要显式关掉：HUD 永远不该横向滚动
                 （横向滚动一旦生效，内容会被按无限宽度测量，卡片就会一路撑出去）。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled">
                <ItemsRepeater x:Name="SessionsRepeater" ItemsSource="{Binding Sessions}"
                               Margin="{Binding Metrics.ScrollPadding}">
                    <ItemsRepeater.Layout>
                        <!-- Layout 与 ItemTemplate 由 ApplyViewMode() 在代码里切换：
                               列表 = 这个 StackLayout + 下面的内联模板（详细卡片）
                               格子 = UniformGridLayout + GridTileTemplate（磁贴平铺）
                             ItemsRepeater 的 Layout / ItemTemplate 都是普通属性
                             （不像 ItemsPanelTemplate 那样藏在模板内部），所以能在代码里直接换，
                             不会踩「面板里拿不到 DataContext」的坑。 -->
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="{Binding Metrics.CardPadding}"
                                    Margin="{Binding Metrics.CardMargin}">
                                <!-- Spacing 给足：当前工作块 Collapsed 时（会话空闲），
                                     标题与「最近活动」之间也必须有明显间隔，否则两行会挤在一起。 -->
                                <StackPanel Spacing="{Binding Metrics.CardSpacing}">

                                    <!-- 标题行：状态点 + 标题 + 计时 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0"
                                                 VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   FontSize="{Binding Metrics.TitleFontSize}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{Binding Metrics.ElapsedFontSize}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>

                                    <!-- 当前工作 -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="5"
                                            Padding="{Binding Metrics.InnerPadding}"
                                            Visibility="{Binding CurrentVisibility}">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding CurrentLabel}" FontWeight="SemiBold"
                                                       FontSize="{Binding Metrics.SmallFontSize}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding CurrentDetail}"
                                                       TextWrapping="Wrap" MaxLines="3"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Cascadia Mono,Consolas,Courier New"
                                                       FontSize="{Binding Metrics.MonoFontSize}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 最近活动 -->
                                    <StackPanel Spacing="{Binding Metrics.SectionSpacing}"
                                                Visibility="{Binding ToolsVisibility}">
                                        <!-- 分隔线：让「最近活动」明确成为独立区块，而不是贴在标题下面 -->
                                        <Border Height="1"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <TextBlock Text="最近活动" CharacterSpacing="80"
                                                   FontSize="{Binding Metrics.SmallFontSize}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <ItemsControl ItemsSource="{Binding Tools}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="{Binding Metrics.ToolRowHeight}">
                                                        <!-- 固定宽度的 TextBlock + Auto 列：见文件头的说明。
                                                             ColumnDefinition 不能绑定，所以宽度写在 TextBlock 上。 -->
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                                   Width="{Binding Metrics.GlyphColumnWidth}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{Binding Metrics.SmallFontSize}"
                                                                   Foreground="{Binding Brush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   Width="{Binding Metrics.NameColumnWidth}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   FontSize="{Binding Metrics.BodyFontSize}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   FontSize="{Binding Metrics.BodyFontSize}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding TimeText}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{Binding Metrics.SmallFontSize}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 上一条模型输出：走 Markdown 渲染（**粗体** / `代码` / 链接 …），
                                         否则模型输出里的 ** 会原样显示出来。 -->
                                    <RichTextBlock TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="{Binding Metrics.LastTextLines}"
                                                   FontSize="{Binding Metrics.BodyFontSize}"
                                                   Visibility="{Binding LastTextVisibility}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   local:MarkdownText.Source="{Binding LastText}" />

                                    <TextBlock Text="{Binding MetaText}" TextTrimming="CharacterEllipsis"
                                               FontSize="{Binding Metrics.SmallFontSize}"
                                               Visibility="{Binding MetaVisibility}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 空状态 -->
            <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="24" TextWrapping="Wrap"
                       FontSize="{Binding Metrics.BodyFontSize}"
                       Visibility="{Binding EmptyVisibility}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="3" Padding="12,6"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusBarText}" TextTrimming="CharacterEllipsis"
                       FontSize="{Binding Metrics.SmallFontSize}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Border>
    </Grid>
</Window>
